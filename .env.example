# Copier ce fichier en .env puis remplacer les valeurs.
# Le fichier .env est ignoré par Git : il ne doit jamais être commité.

# --- PostgreSQL ---
POSTGRES_USER=camporga
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=camporga

# --- API ---
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# --- Premier super admin (script backend/scripts/bootstrap_admin.py) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-12-chars-min
